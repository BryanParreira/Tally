{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Kindred windows are allowed to do",
  "windows": [
    "main",
    "nowbar",
    "notice"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
