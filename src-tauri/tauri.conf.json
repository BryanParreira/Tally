{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kindred",
  "version": "0.1.0",
  "identifier": "app.kindred.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Kindred",
        "url": "index.html",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "notice",
        "title": "Kindred",
        "url": "notice.html",
        "width": 400,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "tray",
        "title": "Kindred",
        "url": "tray.html",
        "width": 340,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your day, planned for you.",
    "longDescription": "Kindred turns a quick brain dump, your inbox and your courses into a realistic daily plan that keeps itself on track. Everything stays on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDRjA2NEFFQzk3QzIzOUIKUldTYkkzekpybVR3REdTalRrb1Jxa2FSb0wzN1YyUEl4UzFDZGkwMkR1aCtiWG91dGFBYklUeGwK",
      "endpoints": [
        "https://github.com/BryanParreira/Kindred/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
